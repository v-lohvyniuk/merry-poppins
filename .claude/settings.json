{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(/state/**)",
      "Bash(python scripts/due_cards.py *)",
      "Bash(python scripts/update_card.py *)",
      "Bash(python scripts/add_card.py *)",
      "Bash(bash scripts/check.sh *)",
      "Bash(cd exercises && mvn test *)",
      "Bash(cd exercises && mvn -q test *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(date *)"
    ],
    "deny": [
      "Edit(/exercises/src/main/**)",
      "Edit(/exercises/src/test/**)",
      "Edit(/exercises/**)",
      "Edit(/curriculum/**)",
      "Edit(/scripts/**)",
      "Edit(/.claude/**)",
      "Edit(/.git/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/README.md)",
      "Edit(/.gitignore)",
      "Edit(/.gitattributes)",
      "PowerShell",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(rm *)",
      "Bash(sh -c *)",
      "Bash(bash -c *)"
    ],
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_edit.py\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_bash.py\"",
            "timeout": 15,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_clock.py\" start",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_clock.py\" tick",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
